# --- vpmobil24 / Stundenplan24 ---
SCHULNUMMER=12345678
BENUTZERNAME=dein_benutzername
PASSWORT=dein_passwort

# --- Datenbank: eine URL mit allen Verbindungsdaten ---
# Zum Testen (Datei im Projektordner):
DATABASE_URL=sqlite:///epaper.db
# MariaDB/MySQL:  DATABASE_URL=mysql+pymysql://benutzer:passwort@localhost:3306/epaper
# PostgreSQL:     DATABASE_URL=postgresql+psycopg://benutzer:passwort@localhost:5432/epaper
# Sonderzeichen im Passwort müssen URL-kodiert werden (@ -> %40, : -> %3A, / -> %2F)

# --- Schule ---
# Alle Räume als JSON-Liste (für Bereiche wie "101-103")
ALL_ROOMS=[101,102,103]

# --- Renderer (optional) ---
# Ordner für die fertigen Bilder
IMAGE_DIR=images
# Schriften (Dateiname oder voller Pfad). Standard: DejaVu Sans
# FONT_REGULAR=DejaVuSans.ttf
# FONT_BOLD=DejaVuSans-Bold.ttf
# Wie viele Stunden pro Tag angezeigt werden (auch freie) und wie viele Stunden ein Block hat
NUM_PERIODS=8
BLOCK_SIZE=2

# --- API (optional) ---
# Folder with firmware binaries (<version>.bin)
FIRMWARE_DIR=firmware_bins
# Sleep time for deactivated devices (seconds)
DEACTIVATED_SLEEP_SECONDS=86400
# Set to 1 to enable the interactive docs at /docs (development only)
API_DOCS=0
